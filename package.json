    "test:scale": "node scripts/stress.mjs",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "devDependencies": {
    "@types/node": "22.12.0",
    "playwright": "1.56.1",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  }
}
